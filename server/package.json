{
  "name": "travelai-server",
  "version": "1.0.0",
  "description": "TravelAI Backend REST API with Express and Prisma",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": [
    "travelai",
    "express",
    "prisma",
    "postgresql",
    "rest-api"
  ],
  "author": "TravelAI Team",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
